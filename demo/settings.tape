# Shared by every demo tape; the background matches Neovim's default colorscheme
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 14
Set Width 1500
Set Height 820
Set Padding 14
Set WindowBar Colorful
Set BorderRadius 8
Set TypingSpeed 70ms
Set CursorBlink false
Set Theme { "name": "nvim", "background": "#14161b", "foreground": "#e0e2ea", "cursor": "#e0e2ea", "selection": "#4f5258", "black": "#07080d", "red": "#ffc0b9", "green": "#b3f6c0", "yellow": "#fce094", "blue": "#a6dbff", "magenta": "#ffcaff", "cyan": "#8cf8f7", "white": "#e0e2ea", "brightBlack": "#4f5258", "brightRed": "#ffc0b9", "brightGreen": "#b3f6c0", "brightYellow": "#fce094", "brightBlue": "#a6dbff", "brightMagenta": "#ffcaff", "brightCyan": "#8cf8f7", "brightWhite": "#eef1f8" }
